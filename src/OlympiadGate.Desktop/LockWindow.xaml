<Window x:Class="OlympiadGate.Desktop.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OlympiadGate"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="#10211C"
        FontFamily="Segoe UI"
        Foreground="#F4F7F5">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="820" Margin="48,64" HorizontalAlignment="Center">
                <TextBlock Text="OlympiadGate" FontSize="14" Foreground="#8FA39A"/>
                <TextBlock x:Name="DirectionText" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,4"/>
                <TextBlock x:Name="ProgressText" FontSize="16" Foreground="#C9D6D0" Margin="0,0,0,24"/>
                <TextBlock x:Name="EmptyText"
                           Text="Задачи по этому направлению закончились. Позовите администратора."
                           FontSize="26"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>
                <StackPanel x:Name="TaskPanel">
                    <TextBlock x:Name="NumberText" FontSize="16" Foreground="#8FA39A" Margin="0,0,0,12"/>
                    <TextBlock x:Name="StatementText" FontSize="26" TextWrapping="Wrap" LineHeight="36"/>
                    <Button x:Name="HintButton"
                            Content="Подсказка"
                            Margin="0,18,0,0"
                            HorizontalAlignment="Left"
                            Padding="18,8"
                            FontSize="15"
                            Background="#1C3330"
                            Foreground="#F4F7F5"
                            BorderBrush="#8FA39A"
                            BorderThickness="1"
                            Cursor="Hand"
                            Click="HintButton_Click"/>
                    <Border x:Name="HintPanel" Background="#1C3330" CornerRadius="8" Padding="14" Margin="0,12,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="HintBody" TextWrapping="Wrap" FontSize="20" LineHeight="28"/>
                    </Border>
                    <TextBlock Text="Ответ" Margin="0,28,0,8" Foreground="#8FA39A"/>
                    <TextBox x:Name="AnswerBox" FontSize="22" Padding="12,10" KeyDown="AnswerBox_KeyDown"/>
                    <TextBlock x:Name="HintText" Text="Введите ответ и нажмите «Проверить»." Margin="0,8,0,0" Foreground="#8FA39A"/>
                    <TextBlock x:Name="ErrorText" Margin="0,8,0,0" Foreground="#F0B4A8" FontSize="16"/>
                    <Button x:Name="SubmitButton"
                            Content="Проверить"
                            Margin="0,18,0,0"
                            HorizontalAlignment="Left"
                            Padding="22,10"
                            FontSize="16"
                            Background="#E07A3D"
                            Foreground="White"
                            BorderThickness="0"
                            Click="SubmitButton_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
